#
# The real AirWriter board: ESP32-S3-WROOM-1-N8R2, 8MB flash, 2MB quad PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# The power-up reset (W-1046, W-1059): the test button (IO14, SW3 under the
# panel's test dot) held through power-up for 5 s makes the bootloader erase
# nvs and boot the known-good slot. A bootloader hook does it
# (bootloader_components/airwriter_boot), so IDF's own factory reset, which
# would boot ota_0, stays off. The custom RTC reserve keeps the flag the hook
# leaves for the app's panel cue. main.c checks both, and the pin.
# CONFIG_BOOTLOADER_FACTORY_RESET is not set
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
# W-1076: TLS buffers in PSRAM. A held TLS session (Infinite Mac's relay) took
# ~45 KB of internal RAM and left Wi-Fi and lwIP starving: the web page stalled
# and reconnects failed. GitHub update checks use the same allocator.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
