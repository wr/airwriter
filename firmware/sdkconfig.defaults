# SPDX-License-Identifier: GPL-3.0-or-later
#
# Defaults for the board, an ESP32-S3-WROOM-1-N8R2. ESP-IDF merges
# sdkconfig.defaults.esp32s3 on top of this file; chip-specific settings
# (flash size, PSRAM, the bootloader's power-up reset) go there.

# Console goes over the native USB serial/JTAG peripheral, not a UART -- UART1
# belongs to the printer. See SPEC.md 2.5.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The default 1MB app partition is already 90% full at M4. See partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# W-1046: a new OTA image runs on trial and marks itself valid only once it is
# healthy (components/ota_health); one that crashes or never gets there is
# rolled back by the bootloader. main.c refuses to build without it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Two servers share lwIP's socket table. The webui's esp_http_server takes its
# listen and control sockets plus up to 7 connections (a browser keeps several
# open), and ipp_server a listen socket, one per worker, and one per connection
# waiting in its backlog. At the default 10 a settings page left open could
# leave IPP's accept() with no socket at all.
CONFIG_LWIP_MAX_SOCKETS=16
# At least ipp_server's LISTEN_BACKLOG: a completed connection that finds the
# accept mailbox full is reset rather than queued.
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=8

# W-1116: Bonjour carries six shared printers (PR_SHARE_MAX), one _ipp service
# each, plus the port printer's _printer stub and the settings page's _http:
# 8 of these 10. ipp_server has seven slots (IPP_PRINTERS: slot 0 is the oldest
# port record's alone), but only a slot with a shared record registers, so six
# is the most. Pinned here because releases build from this file alone.
CONFIG_MDNS_MAX_SERVICES=10

# W-1048: only signed images install over the air, from GitHub or /update.
# IDF's signed apps without secure boot: esp_ota_end checks the RSA-3072
# signature block on the new image, and trusts the key that signed the
# running one. No eFuses, and the bootloader is unchanged. Every build is
# signed, because a running image without a signature would refuse every
# update; main.c refuses to build without these.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
# Relative to firmware/ and gitignored. The release key lives off the repo
# (SPEC.md 3.12); a build with a key of your own makes a board that takes
# only your builds. The build says how to make one if it is missing.
CONFIG_SECURE_BOOT_SIGNING_KEY="firmware_signing_key.pem"
