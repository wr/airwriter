menu "AirWriter"

config AIRWRITER_WIFI_SSID
    string "WiFi SSID"
    default ""
    help
        Development credentials only. They land in sdkconfig, which is
        gitignored. Improv-over-BLE provisioning replaces this in M6, and
        credentials stored in NVS already take precedence over this value.

config AIRWRITER_WIFI_PASSWORD
    string "WiFi password"
    default ""

config AIRWRITER_QUEUE_NAME
    string "Print queue name"
    default "ImageWriter II"
    help
        What the iOS print sheet shows. This is the printer's name, not the
        bridge's: AirWriter is the dongle, and a user picking a printer is
        looking for the machine the paper comes out of.

config AIRWRITER_DEV_MODE
    bool "Development mode"
    default n
    help
        Regenerates printer-uuid on every boot. iOS caches printer
        capabilities against the UUID aggressively, and with a stable UUID a
        changed media list or URF string can take an afternoon to show up.
        Off by default: a UUID that moves leaves the iPhone and the Mac
        holding the printer under an old UUID after every reboot. On the
        rev A bench (a dozen reboots in a morning) the iPhone listed two
        "ImageWriter II" entries and, printing to the stale one, polled
        Get-Printer-Attributes forever without sending a job. Turn it on
        only while iterating on advertised capabilities.

config AIRWRITER_UUID_EPOCH
    int "printer-uuid epoch"
    range 0 65535
    default 1
    help
        The printer-uuid is fixed per board (from its MAC) plus this number.
        iOS keys everything about a printer on its UUID, including a cached
        copy of its capabilities: when operations-supported changed under an
        unchanged UUID on the rev A bench, the iPhone held every job at
        "Waiting" and only re-polled Get-Printer-Attributes. Bump this when
        the advertised capabilities change, so phones meet a new printer.
        Ignored in development mode, which picks a random UUID every boot.

config AIRWRITER_UART_NUM
    int "Printer UART port"
    default 1

config AIRWRITER_TX_PIN
    int "Printer TX pin"
    default 17 if IDF_TARGET_ESP32S3
    default 4
    help
        Board net UART_TX. On the AirWriter PCB this is IO17 into the
        MAX3490's DI. Devkits without a transceiver can use anything.

config AIRWRITER_RX_PIN
    int "Printer RX pin"
    default 18 if IDF_TARGET_ESP32S3
    default 5

config AIRWRITER_CTS_PIN
    int "Printer CTS pin (the printer's HSKo), -1 to disable"
    default 8 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net UART_CTS, IO8, fed by the MAX3232 receiver. With this wired
        the UART peripheral stalls its own FIFO when the printer is busy, and
        the same line doubles as the paper sensor.

config AIRWRITER_HSKI_DRV_PIN
    int "SP3232 T1IN pin, -1 if absent"
    default 35 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net HSKI_DRV: IO35 into U3.11, the SP3232's T1IN. Driver inputs
        have no pull-ups and must be tied, so app_main clamps this pin low as
        one of its first acts. T1OUT reaches only the DNP R9 on rev A; rev B
        ties T1IN to GND. Devkits without the transceiver leave it at -1.

config AIRWRITER_BAUD
    int "Printer baud rate"
    default 9600

config AIRWRITER_INVERT_TX
    bool "Invert the transmit line"
    default n
    help
        Insurance for the differential polarity, which is resolved from
        secondary sources but not yet confirmed against hardware. Inverting DI
        swaps Y and Z together and is electrically identical to swapping the
        pair. SPEC.md 2.4, assumption 3.

config AIRWRITER_INVERT_RX
    bool "Invert the receive line"
    default n

config AIRWRITER_INVERT_CTS
    bool "Invert the CTS (printer HSKo) line"
    default n
    help
        Insurance for the handshake polarity. The board expects HSKo asserted
        (printer ready) to reach IO8 as logic LOW through the SP3232
        receiver. If a scope on the real printer shows the opposite, turn
        this on: it flips both the UART peripheral's CTS sense and the
        watchdog's paper sensor. SPEC.md 3.9.

config AIRWRITER_STALL_TIMEOUT
    int "Seconds of HSKo deassertion mid-job before the panel asks for attention"
    default 30
    help
        The printer holds HSKo false briefly on every line; only a stall this
        long mid-job means paper, a jam or SELECT. The job pauses, it is not
        failed -- see AIRWRITER_STALL_ABORT.

config AIRWRITER_STALL_ABORT
    int "Seconds a paused job waits for the printer before it is failed"
    default 600

config AIRWRITER_LED_DATA_PIN
    int "LED chain data pin, -1 if absent"
    default 48 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net LED_DATA: IO48 into U9, the 3.3-to-5V level shifter feeding
        the SK6812 chain. U9's input has no pull-down on rev A, so the chain
        sees noise from power-on until app_main clamps this pin low as its
        first act. led_grid takes the pin over when that component lands.
        Devkits without the level shifter leave it at -1.

config AIRWRITER_LED_COUNT
    int "LED chain length"
    default 37
    help
        37 on the AirWriter board (D10-D46). A devkit with a shorter SK6812
        strip sets its real count; frames are rendered for the board's 37
        dots and truncated to the strip.

config AIRWRITER_UART_LOOPBACK
    bool "Loop the printer UART back on itself"
    default y if !IDF_TARGET_ESP32S3
    default n
    help
        Feeds TX straight back into RX inside the peripheral so the whole path
        can be checked on a devkit with no transceiver attached. The received
        bytes are checksummed and compared with what was sent. Never enable
        this on a real board: nothing reaches the printer.

config AIRWRITER_DIP1_PIN
    int "DIP1 pin, -1 if absent"
    default 38 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP1, closed = GND, internal pull-up.

config AIRWRITER_DIP2_PIN
    int "DIP2 pin, -1 if absent"
    default 39 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP2, closed = GND, internal pull-up.

config AIRWRITER_DIP3_PIN
    int "DIP3 pin, -1 if absent"
    default 40 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP3, closed = GND, internal pull-up.

config AIRWRITER_DIP4_PIN
    int "DIP4 pin, -1 if absent"
    default 41 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP4, closed = GND, internal pull-up.

config AIRWRITER_DIP5_PIN
    int "DIP5 pin, -1 if absent"
    default 42 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP5, closed = GND, internal pull-up.

config AIRWRITER_DIP6_PIN
    int "DIP6 pin, -1 if absent"
    default 47 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP6, closed = GND, internal pull-up.

config AIRWRITER_DIP7_PIN
    int "DIP7 pin, -1 if absent"
    default 21 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP7, closed = GND, internal pull-up.

config AIRWRITER_DIP8_PIN
    int "DIP8 pin, -1 if absent"
    default 13 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net DIP8, closed = GND, internal pull-up.

config AIRWRITER_TEST_BTN_PIN
    int "Test-page button pin, -1 if absent"
    default 14 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net TEST_BTN, closed = GND, internal pull-up. A press prints a
        self-test page through the same raster and serial path as a real job.

config AIRWRITER_PIC_MCLR_PIN
    int "LocalTalk PIC MCLR pin, -1 if absent"
    default 2 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net LT_RESET, straight to U7 pin 4 (RA3/MCLR). Low holds TashTalk
        in reset; low plus the LVP key puts the PIC in programming mode. The
        three PIC pins together enable the web UI's "flash TashTalk" button.
        On a devkit, wire them to a breadboard PIC and set them here.

config AIRWRITER_PIC_CLK_PIN
    int "LocalTalk PIC ICSPCLK pin, -1 if absent"
    default 4 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net LT_UART_TX, through R15 (100R) to U7 pin 6 (RA1/ICSPCLK).
        TashTalk's UART receive line in normal running, so app_main clamps it
        high (UART idle) at boot rather than leave TashTalk decoding a float.

config AIRWRITER_PIC_DAT_PIN
    int "LocalTalk PIC ICSPDAT pin, -1 if absent"
    default 5 if IDF_TARGET_ESP32S3
    default -1
    help
        Board net LT_UART_RX, through R16 (100R) to U7 pin 7 (RA0/ICSPDAT).
        TashTalk's UART transmit line in normal running.

endmenu
