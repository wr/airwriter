(version 1)

# Local ground-stitch clearance relaxation (W-573 GND integrity).
# Scoped to small named rule areas 'GND_STITCH_012' placed only around the GND
# stitch via(s) that tie otherwise-stranded grounds (e.g. U5 ESD) to the main
# plane in the board's densest pinch points. Everywhere else stays at the global
# 0.15mm netclass clearance. SOURCING: PCBWay quote must allow 0.12mm (4.7 mil)
# min trace/space at these points.
(rule "gnd_stitch_local_012"
	(condition "A.insideArea('GND_STITCH_012')")
	(constraint clearance (min 0.12mm)))
