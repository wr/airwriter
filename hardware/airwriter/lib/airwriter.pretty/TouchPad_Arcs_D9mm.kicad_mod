(footprint "TouchPad_Arcs_D9mm"
	(version 20240108)
	(generator "airwriter")
	(layer "B.Cu")
	(descr "Capacitive touch pad for the back face. The electrode is a solid 9.2mm copper disc -- self-capacitance wants unbroken area -- and the pattern lives in the soldermask, so it reads as fine gold arcs on matte black with continuous copper beneath. Arcs are 0.18mm wide on a 0.45mm pitch, leaving 0.27mm mask dams, well clear of the 0.1mm fab floor.")
