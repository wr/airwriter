(footprint "EVQP44B3M_SidePress"
	(version 20240108)
	(generator "airwriter")
	(layer "F.Cu")
	(descr "Panasonic EVQP44B3M side-press (edge-mount) SMD tactile switch, LCSC C79164, in stock. Body 6.2 (X, length) x 3.0mm (Y, width), 3.5mm tall, 1.35mm standoff, actuator protrudes ~0.45mm past the +X edge (edge-mount convention: overhang faces the board edge/case pinhole). DERIVED, NOT TRACED: Panasonic's outline drawing PDF is image-based, same class of gap as the DP-08RP lookup earlier in this project -- pad positions below are a conservative edge-mount-family estimate (2 switch pads inboard, 2 ground/anchor pads at the actuator end), not read off the real drawing. Verify against a physical part before a fab run that depends on exact pad geometry.")
	(tags "tactile switch side press edge mount EVQP4 C79164")
	(attr smd)
	(duplicate_pad_numbers_are_jumpers no)
	(property "Reference" "SW**" (at 0 -2.3 0) (layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "EVQP44B3M_SidePress" (at 0 2.3 0) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Footprint" "" (at 0 0 0) (layer "F.Fab") (hide yes)
		(effects (font (size 1 1) (thickness 0.15))))
	(fp_rect (start -3.1 -1.5) (end 3.1 1.5) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_line (start -3.1 -0.6) (end -3.1 0.6) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 3.1 -1.5) (end 3.55 -0.45) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 3.55 -0.45) (end 3.55 0.45) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 3.55 0.45) (end 3.1 1.5) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start -3.3 -1.7) (end 3.75 -1.7) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 3.75 -1.7) (end 3.75 1.7) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 3.75 1.7) (end -3.3 1.7) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start -3.3 1.7) (end -3.3 -1.7) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_text user "%R" (at 0 0 0) (layer "F.Fab")
		(effects (font (size 0.8 0.8) (thickness 0.12))))
	(pad "1" smd rect (at -2.55 -1.0) (size 1.3 0.9) (layers "F.Cu" "F.Mask" "F.Paste"))
	(pad "1" smd rect (at -2.55 1.0) (size 1.3 0.9) (layers "F.Cu" "F.Mask" "F.Paste"))
	(pad "2" smd rect (at 2.55 -1.0) (size 1.3 0.9) (layers "F.Cu" "F.Mask" "F.Paste"))
	(pad "2" smd rect (at 2.55 1.0) (size 1.3 0.9) (layers "F.Cu" "F.Mask" "F.Paste"))
)
