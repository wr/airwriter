#VRML V2.0 utf8
# Panasonic EVQP44B3M side-press SMD tactile switch.
# Body dims from the LCSC listing; the actuator plate matches the derived footprint's
# F.Fab overhang (0.45mm past the +X body face). Authored in mm / 2.54.
Group { children [
	# body 6.2 x 3.0 x 3.5
	Transform {
		translation 0 0 0.689
		children [ Shape {
			appearance Appearance { material Material {
				diffuseColor 0.12 0.12 0.14
				specularColor 0.15 0.15 0.15
				shininess 0.2
			} }
			geometry Box { size 2.4409 1.1811 1.378 }
		} ]
	}
	# actuator plate
	Transform {
		translation 1.3091 0 0.689
		children [ Shape {
			appearance Appearance { material Material {
				diffuseColor 0.80 0.80 0.82
				specularColor 0.15 0.15 0.15
				shininess 0.2
			} }
			geometry Box { size 0.1772 0.3543 0.3937 }
		} ]
	}
] }
