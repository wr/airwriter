# KiCad
*-backups/
*.kicad_prl
!hardware/airwriter/lib/**
fp-info-cache
*.kicad_pcb-bak
*.kicad_sch-bak
*.net

# ESP-IDF
firmware/build/
firmware/.cache/
firmware/sdkconfig
firmware/sdkconfig.old
# Rev 2026.11's build (W-1109); its sdkconfig can hold Wi-Fi credentials too.
firmware/build-2026.11/
firmware/sdkconfig.2026.11
firmware/sdkconfig.2026.11.old
# Left over from the retired ESP32-C6 devkit target; sdkconfig.c6 can hold Wi-Fi credentials.
firmware/build_c6/
firmware/sdkconfig.c6
firmware/sdkconfig.c6.old
firmware/managed_components/
firmware/dependencies.lock

# host tools
tools/rip/build/
tools/ipp/build/
*.o
*.d
__pycache__/
*.pyc

# macOS
.DS_Store

# KiCad 10 auto-versioning
.history/
.superpowers/

# enclosure
enclosure/.venv/
# the STEPs rebuild with enclosure/build.sh; the printable STLs are committed
enclosure/out/*
!enclosure/out/*.stl

# Implementation plans live in Wells's private notes, not here
docs/superpowers/plans/

# W-1048: a signing key never goes in the repo (the public key is in firmware/keys/)
firmware/*.pem
