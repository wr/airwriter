 "states": {
  "normal": {
   "about": "Board 1 as it is: ready, colour ribbon, home Wi-Fi",
   "patch": {}
  },
  "no-printer": {
   "about": "No cable, or the printer is off",
   "patch": {
    "GET /api/status": {
     "ps": "offline",
     "state": "Printer offline",
     "printer": false,
     "stopped": true,
     "ribbon": "unknown"
    }
   }
  },
  "paper": {
   "about": "Out of paper or SELECT off",
   "patch": {
    "GET /api/status": {
     "ps": "attention",
     "state": "Needs attention",
     "fault": true,
     "stopped": true
    }
   }
  },
  "failed": {
   "about": "The last job failed",
   "patch": {
    "GET /api/status": {
     "ps": "failed",
     "state": "Last job failed",
     "fault": true,
     "job": "Holiday card.pdf (2 pages)"
    }
   }
  },
  "printing": {
   "about": "Printing a job",
   "patch": {
    "GET /api/status": {
     "ps": "printing",
     "state": "Printing",
     "printing": true,
     "job": "Holiday card.pdf (2 pages)"
    }
   }
  },
  "ribbon-unknown": {
   "about": "The ribbon not read yet",
   "patch": {
    "GET /api/status": {
     "ribbon": "unknown"
    }
   }
  },
  "booting": {
   "about": "Just started: printer not settled",
   "patch": {
    "GET /api/status": {
     "ps": "booting",
     "state": "Starting",
     "printer": false,
     "ribbon": "unknown",
     "uptime": "0h 00m"
    }
   }
  },
